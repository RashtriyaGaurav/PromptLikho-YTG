       <script>

let page = 2;
let loading = false;
let hasMore = true;

const gallery = document.getElementById("gallery");

let skeletonCards = [];

function showSkeleton() {

    skeletonCards = [];

    for (let i = 0; i < 8; i++) {

        const div = document.createElement("div");

        div.className = "border border-hairline bg-surface skeleton-card";

        div.innerHTML = `
            <div class="skeleton h-55 sm:h-90"></div>

            <div class="p-3">

                <div class="skeleton h-5 rounded mb-3"></div>

                <div class="flex justify-between">

                    <div class="skeleton h-3 w-20 rounded"></div>

                    <div class="skeleton h-3 w-10 rounded"></div>

                </div>

            </div>
        `;

        gallery.appendChild(div);

        skeletonCards.push(div);

    }

}

function hideSkeleton() {

    skeletonCards.forEach(card => card.remove());

    skeletonCards = [];

}

async function loadImages() {

    if (loading || !hasMore) return;

    loading = true;

    showSkeleton();

    try {

        const params = new URLSearchParams(window.location.search);

        params.set("page", page);

        const res = await fetch(`/api/images?${params}`);

        const data = await res.json();

        data.images.forEach(image => {

            gallery.insertAdjacentHTML("beforeend", `
                <a href="/image/${image.slug}"
                    class="card group relative block border border-hairline bg-surface">

                    <div class="relative overflow-hidden">
                        <img
                            src="${image.image.url}"
                            class="card-img w-full h-55 sm:h-90 object-top object-cover"
                            loading="lazy"
                            alt="${image.seo.alt}">
                    </div>

                    <div class="p-2 sm:p-3">

                        <h2 class="font-display hidden sm:block text-lg line-clamp-2">
                            ${image.title}
                        </h2>

                        <div class="flex justify-between items-center">

                            <p class="font-mono text-[10px] tracking-[0.2em] uppercase text-accent">
                                ${image.category.name}
                            </p>

                            <span class="font-mono text-sm">
                                👁 ${image.stats.views}
                            </span>

                        </div>

                    </div>

                </a>
            `);

        });

        hasMore = data.hasMore;

        if (hasMore) page++;

        if (!hasMore) {
            observer.disconnect();
        }

    } catch (err) {

        console.error(err);

    } finally {

        hideSkeleton();

        loading = false;

    }

}

const observer = new IntersectionObserver(entries => {

    if (entries[0].isIntersecting) {
        loadImages();
    }

}, {
    rootMargin: "500px"
});

observer.observe(document.getElementById("load-more"));


</script>

</body>

